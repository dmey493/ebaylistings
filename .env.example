# ---- The "brain" (identifies the item and writes the listing) ----
# claude-code : uses your Claude plan through headless Claude Code (`claude -p`). No API key needed.
# api         : calls the Messages API directly; needs ANTHROPIC_API_KEY and pay-as-you-go billing.
EBAYLISTER_BRAIN=claude-code
EBAYLISTER_CLAUDE_CMD=claude    # path to the Claude Code binary if it is not on PATH
#ANTHROPIC_API_KEY=sk-ant-...   # only for EBAYLISTER_BRAIN=api

# ---- eBay developer app (https://developer.ebay.com/my/keys) ----
EBAY_ENV=sandbox                # sandbox | production
EBAY_CLIENT_ID=                 # "App ID (Client ID)"
EBAY_CLIENT_SECRET=             # "Cert ID (Client Secret)"
EBAY_RUNAME=                    # the RuName of your redirect URL (used as redirect_uri)
EBAY_MARKETPLACE_ID=EBAY_US

# ---- Seller defaults (filled in by `ebaylister setup`) ----
EBAY_MERCHANT_LOCATION_KEY=home
EBAY_FULFILLMENT_POLICY_ID=
EBAY_PAYMENT_POLICY_ID=
EBAY_RETURN_POLICY_ID=

# ---- Behaviour ----
EBAYLISTER_DATA_DIR=./data      # jobs, photos, drafts, tokens live here
EBAYLISTER_AUTO_PUBLISH=false   # true = publish without a review step
EBAYLISTER_MODEL=claude-opus-5   # api brain only
