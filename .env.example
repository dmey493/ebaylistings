# ---- Anthropic ----
ANTHROPIC_API_KEY=sk-ant-...

# ---- eBay developer app (https://developer.ebay.com/my/keys) ----
EBAY_ENV=sandbox                # sandbox | production
EBAY_CLIENT_ID=                 # "App ID (Client ID)"
EBAY_CLIENT_SECRET=             # "Cert ID (Client Secret)"
EBAY_RUNAME=                    # the RuName of your redirect URL (used as redirect_uri)
EBAY_MARKETPLACE_ID=EBAY_US

# ---- Seller defaults (filled in by `ebaylister setup`) ----
EBAY_MERCHANT_LOCATION_KEY=home
EBAY_FULFILLMENT_POLICY_ID=
EBAY_PAYMENT_POLICY_ID=
EBAY_RETURN_POLICY_ID=

# ---- Behaviour ----
EBAYLISTER_DATA_DIR=./data      # jobs, photos, drafts, tokens live here
EBAYLISTER_AUTO_PUBLISH=false   # true = publish without a review step
EBAYLISTER_MODEL=claude-opus-5
